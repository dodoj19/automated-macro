<Window x:Class="AutomatedMacro.RecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutomatedMacro"
        Title="{local:Tr RecorderTitle}"
        Width="390" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource PanelBgBrush}" Foreground="{StaticResource TextBrush}"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="Width" Value="92"/>
        </Style>
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="ToolTip" Value="{local:Tr Add}"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">
            <!-- Zaglavlje -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{local:Tr Tip_CursorPos}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;" FontSize="12" Foreground="{StaticResource FaintTextBrush}"/>
                    <TextBlock Text="{Binding CursorText}" Margin="6,0,0,0" FontFamily="Consolas" Foreground="{StaticResource DimTextBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="11" Height="11" Fill="{StaticResource RecordBrush}" VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="{local:Tr RecordingCaps}" Margin="10,0,0,0" FontWeight="SemiBold" Foreground="#FF8A8D" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- Zadnji klik -->
            <Border Margin="0,14,0,0" Padding="14,10" CornerRadius="8" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{local:Tr LastClick}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource DimTextBrush}"/>
                    <TextBlock Text="{Binding CaptureText}" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCapture}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Vrsta koraka -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <RadioButton Content="{local:Tr Click}" MinWidth="0" Margin="0,0,18,0" IsChecked="{Binding IsClickStep}"/>
                <RadioButton Content="{local:Tr ClickPlusText}" MinWidth="0" IsChecked="{Binding IsTextStep}"/>
            </StackPanel>

            <StackPanel Visibility="{Binding IsTextStep, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr Text}"/>
                    <ComboBox ItemsSource="{x:Static local:Choices.TextModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding TextKind}" HorizontalAlignment="Stretch"/>
                </DockPanel>
                <StackPanel Visibility="{Binding TextKind, Converter={StaticResource EnumToVis}, ConverterParameter=Fixed}">
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                        <TextBox Text="{Binding FixedText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="90" VerticalScrollBarVisibility="Auto"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                        <CheckBox Content="{local:Tr HideInViewPassword}" IsChecked="{Binding Masked}"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding TextKind, Converter={StaticResource EnumToVis}, ConverterParameter=Random}">
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr Length}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MinLength}"/>
                            <TextBlock Grid.Column="1" Text="{local:Tr To}" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}"/>
                            <TextBox Grid.Column="2" Text="{Binding MaxLength}"/>
                        </Grid>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr Characters}"/>
                        <ComboBox ItemsSource="{x:Static local:Choices.Charsets}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Charset}" HorizontalAlignment="Stretch"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr PrefixSuffix}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Tr Eg_User}"/>
                            <TextBox Grid.Column="2" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Tr Eg_Mail}"/>
                        </Grid>
                    </DockPanel>
                </StackPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource RowLabel}" Text=""/>
                    <StackPanel>
                        <CheckBox Content="{local:Tr ClearFieldBefore}" IsChecked="{Binding ClearFirst}"/>
                        <CheckBox Content="{local:Tr EnterAfter}" IsChecked="{Binding PressEnter}"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <DockPanel Style="{StaticResource Row}" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr DelayAfter}"/>
                <TextBlock DockPanel.Dock="Right" Text="ms" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}"/>
                <TextBox Text="{Binding DelayAfterMs}"/>
            </DockPanel>

            <Button Style="{StaticResource AccentButton}" Click="SaveStep_Click" Margin="0,6,0,0" Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="15"/>
                    <TextBlock Text="{local:Tr SaveStep}" Margin="10,0,0,0" FontSize="14"/>
                    <TextBlock Text="F8" Margin="10,0,0,0" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding Message, Converter={StaticResource TextToVis}}"/>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

            <!-- Dodatni koraci -->
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr AddTo}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource AddButton}" Click="ExitGroup_Click" ToolTip="{local:Tr Tip_ExitGroup}">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;"/>
                </Button>
                <ComboBox ItemsSource="{Binding Targets}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTarget}"
                          HorizontalAlignment="Stretch" DropDownOpened="Targets_DropDownOpened"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr Wait}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource AddButton}" Click="AddWait_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="ms" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}"/>
                <TextBox Text="{Binding WaitMs}"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr Key}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource AddButton}" Click="AddKey_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"/>
                </Button>
                <ComboBox ItemsSource="{x:Static local:Choices.Keys}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedKey}"
                          HorizontalAlignment="Stretch"/>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
                <TextBlock Style="{StaticResource RowLabel}" Text="{local:Tr NewGroup}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource AddButton}" Click="AddGroup_Click">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;"/>
                </Button>
                <Grid>
                    <TextBox x:Name="GroupNameBox" Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock IsHitTestVisible="False" Text="{local:Tr GroupNamePlaceholder}" Margin="11,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource FaintTextBrush}"
                               Visibility="{Binding Text, ElementName=GroupNameBox, Converter={StaticResource InvTextToVis}}"/>
                </Grid>
            </DockPanel>

            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,8,0,14"/>

            <DockPanel>
                <Button DockPanel.Dock="Right" Click="Undo_Click" IsEnabled="{Binding CanUndo}" Padding="10,5" MinWidth="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE7A7;"/>
                        <TextBlock Text="{local:Tr UndoLast}" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="{local:Tr SavedLabel}" Foreground="{StaticResource DimTextBrush}"/>
                        <Run Text="{Binding SavedCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="{Binding LastSavedText}" FontSize="12" Foreground="{StaticResource FaintTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,10,0"/>
                </StackPanel>
            </DockPanel>

            <Button Style="{StaticResource BigToolButton}" Click="Finish_Click" Margin="0,16,0,0" HorizontalContentAlignment="Center"
                    BorderBrush="#7A2E33" Padding="12,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Rectangle Width="12" Height="12" RadiusX="2" RadiusY="2" Fill="{StaticResource RecordBrush}"/>
                    <TextBlock Text="{local:Tr FinishRecording}" Margin="10,0,0,0" FontSize="14"/>
                    <TextBlock Text="F9" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="{local:Tr RecorderHint}"/>
        </StackPanel>
    </ScrollViewer>
</Window>
