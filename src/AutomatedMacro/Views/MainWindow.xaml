<Window x:Class="AutomatedMacro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AutomatedMacro"
        Title="{Binding WindowTitle}"
        Width="1540" Height="1000" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        Foreground="{StaticResource TextBrush}"
        Icon="/Assets/app.ico"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Redak tablice koraka -->
        <DataTemplate x:Key="StepRowTemplate">
            <Grid MinHeight="34" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="104"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Number}" Foreground="{StaticResource DimTextBrush}" Margin="16,8,0,0" FontSize="13"/>
                <Grid Grid.Column="1">
                    <local:GuideLines Depth="{Binding Depth}"/>
                    <StackPanel Margin="{Binding Depth, Converter={StaticResource DepthToMargin}}">
                        <StackPanel Orientation="Horizontal" Height="33">
                            <Grid Width="22">
                                <ToggleButton Style="{StaticResource ChevronToggle}" IsChecked="{Binding IsExpanded}"
                                              Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17" Width="22" TextAlignment="Center"
                                       Margin="4,0,0,0" Foreground="{Binding IconColor, Converter={StaticResource HexToBrush}}"/>
                            <TextBlock Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DetailText}" Margin="60,-5,8,8" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{Binding DetailColor, Converter={StaticResource HexToBrush}}"
                                   Visibility="{Binding DetailText, Converter={StaticResource TextToVis}}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding ActionText}" Margin="0,8,10,0" FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="3" Text="{Binding DelayText}" Margin="0,8,0,0" FontSize="13"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="FormRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="FormLabelW" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="Width" Value="132"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DimTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Width" Value="22"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="282"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Alatna traka ================= -->
        <Border Grid.Row="0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource BigToolButton}" Click="Record_Click"
                        ToolTip="{local:Tr Tip_Record}">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="{StaticResource RecordBrush}"/>
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White"
                                       Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{local:Tr Record}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                <Setter Property="Text" Value="{local:Tr FinishRecording}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="F9" FontSize="13" Foreground="{StaticResource DimTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource BigToolButton}" Click="Stop_Click" Margin="10,0,0,0" IsEnabled="{Binding CanStop}"
                        ToolTip="{local:Tr Tip_Stop}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="24" Height="24" RadiusX="3" RadiusY="3" Fill="#6B6B76"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:Tr Stop}" FontSize="14"/>
                            <TextBlock Text="F10" FontSize="13" Foreground="{StaticResource DimTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="18,4"/>

                <Button Style="{StaticResource BigToolButton}" Click="Run_Click" IsEnabled="{Binding IsIdle}" BorderBrush="#2F6B4C"
                        ToolTip="{local:Tr Tip_Run}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M0,0 L20,12 L0,24 Z" Fill="{StaticResource SuccessBrush}" Width="20" Height="24" Stretch="Fill"
                              Margin="4,0,4,0"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{local:Tr RunLoop}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Settings.Loop}" Value="False">
                                                <Setter Property="Text" Value="{local:Tr RunOnce}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="F5" FontSize="13" Foreground="{StaticResource DimTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource BorderBrush}" Margin="26,4,14,4"/>

                <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                    <Button Style="{StaticResource IconLabelButton}" Click="New_Click" ToolTip="{local:Tr Tip_New}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="{local:Tr New}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconLabelButton}" Click="Open_Click" ToolTip="{local:Tr Tip_Open}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE838;" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="{local:Tr Open}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconLabelButton}" Click="Save_Click" ToolTip="{local:Tr Tip_Save}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" FontSize="22" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentLightBrush}"/>
                            <TextBlock Text="{local:Tr Save}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconLabelButton}" Click="SaveAs_Click" ToolTip="{local:Tr Tip_SaveAs}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE792;" FontSize="22" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentLightBrush}"/>
                            <TextBlock Text="{local:Tr SaveAs}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="12,4"/>
                    <Button x:Name="SettingsButton" Style="{StaticResource IconLabelButton}" Click="Settings_Click" ToolTip="{local:Tr Tip_Settings}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="{local:Tr Settings}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AboutButton" Style="{StaticResource IconLabelButton}" Click="About_Click" ToolTip="{local:Tr Tip_About}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="22" HorizontalAlignment="Center"/>
                            <TextBlock Text="{local:Tr About}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="20" Width="360">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr SettingsHeader}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Tr Language}" Margin="0,14,0,5"/>
                    <ComboBox ItemsSource="{x:Static local:Choices.Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding App.Language}" HorizontalAlignment="Stretch"/>
                    <CheckBox Content="{local:Tr MinimizeRun}" Margin="0,16,0,0" IsChecked="{Binding App.MinimizeDuringRun}"/>
                    <CheckBox Content="{local:Tr MinimizeRecord}" Margin="0,4,0,0" IsChecked="{Binding App.MinimizeDuringRecord}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Tr LibraryFolder}"/>
                    <TextBlock Text="{Binding App.EffectiveLibraryFolder}" TextWrapping="Wrap" FontSize="12"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource SmallButton}" Content="{local:Tr Change}" Click="ChangeLibrary_Click"/>
                        <Button Style="{StaticResource SmallButton}" Content="{local:Tr OpenInExplorer}" Click="OpenLibraryFolder_Click"/>
                        <Button Style="{StaticResource SmallButton}" Content="{local:Tr Default}" Click="ResetLibrary_Click"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{local:Tr Shortcuts}"/>
                    <TextBlock FontSize="12" Foreground="{StaticResource DimTextBrush}" LineHeight="20" TextWrapping="Wrap"
                               Text="{local:Tr ShortcutsHelp}"/>
                </StackPanel>
            </Border>
        </Popup>

        <Popup x:Name="AboutPopup" PlacementTarget="{Binding ElementName=AboutButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" VerticalOffset="6">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="22" Width="350">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr AboutHeader}"/>
                    <DockPanel Margin="0,16,0,0">
                        <Image DockPanel.Dock="Left" Source="/Assets/app-256.png" Width="56" Height="56" Margin="0,0,16,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Automated Macro" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,0">
                                <Run Text="{local:Tr VersionLabel}"/>
                                <Run Text="{Binding Version, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{local:Tr AboutDescription}" TextWrapping="Wrap" LineHeight="20" Margin="0,16,0,0"
                               Foreground="{StaticResource DimTextBrush}"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,18"/>
                    <TextBlock Text="Made by Dorijan J." FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="© 2026 Dorijan J." FontSize="12" Margin="0,4,0,0" Foreground="{StaticResource FaintTextBrush}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- ================= Glavni dio ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Lijevo: popis makroa ===== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}" Padding="20,18,20,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="{local:Tr Macros}"/>
                    <Grid DockPanel.Dock="Top" Margin="0,14,0,12">
                        <TextBox x:Name="SearchBox" Text="{Binding LibrarySearch, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Padding="12,7,34,7"/>
                        <TextBlock IsHitTestVisible="False" Text="{local:Tr SearchMacros}" Margin="13,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource FaintTextBrush}"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource InvTextToVis}}"/>
                        <TextBlock IsHitTestVisible="False" Style="{StaticResource Glyph}" Text="&#xE721;" HorizontalAlignment="Right"
                                   Margin="0,0,12,0" Foreground="{StaticResource FaintTextBrush}"/>
                    </Grid>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource OutlineAccentButton}" Click="NewMacro_Click" Margin="0,12,0,0"
                            IsEnabled="{Binding IsIdle}" ToolTip="{local:Tr Tip_NewMacro}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="15"/>
                            <TextBlock Text="{local:Tr NewProcedure}" Margin="10,0,0,0" FontSize="14"/>
                        </StackPanel>
                    </Button>
                    <TreeView x:Name="LibraryTree" ItemsSource="{Binding Library}" Background="Transparent" BorderThickness="0"
                              Margin="-8,0,-8,0" IsEnabled="{Binding IsIdle}"
                              PreviewMouseLeftButtonUp="Library_PreviewMouseLeftButtonUp"
                              PreviewMouseRightButtonUp="Library_PreviewMouseRightButtonUp">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:LibraryItem}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16"
                                               Foreground="{Binding GlyphColor, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold"/>
                                        <Setter TargetName="NameText" Property="Foreground" Value="#D6CCFF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTrashed}" Value="True">
                                        <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

            <!-- ===== Sredina: urednik procedure ===== -->
            <DockPanel Grid.Column="2">
                <!-- Kartica dokumenta -->
                <Border DockPanel.Dock="Top" Background="{StaticResource PanelBgBrush}" Padding="10,10,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#28233F" CornerRadius="8,8,0,0" Padding="18,9,8,9"
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DocumentName}" FontSize="14" VerticalAlignment="Center"/>
                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentLightBrush}" Margin="9,1,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" ToolTip="{local:Tr UnsavedChanges}"/>
                                <Button Style="{StaticResource FlatIconButton}" Click="CloseDocument_Click" Margin="12,0,0,0" Padding="6"
                                        IsEnabled="{Binding IsIdle}" ToolTip="{local:Tr CloseProcedure}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="10"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Traka za uredjivanje -->
                <Border DockPanel.Dock="Top" Padding="14,6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsIdle}">
                        <Button Style="{StaticResource FlatIconButton}" Click="Cut_Click" ToolTip="{local:Tr Tip_Cut}" IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C6;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource FlatIconButton}" Click="Copy_Click" ToolTip="{local:Tr Tip_Copy}" IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource FlatIconButton}" Click="Paste_Click" ToolTip="{local:Tr Tip_Paste}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource FlatIconButton}" Click="Duplicate_Click" ToolTip="{local:Tr Tip_Duplicate}" IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xF413;" FontSize="16"/>
                        </Button>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,6"/>
                        <Button Style="{StaticResource FlatIconButton}" Click="AddGroup_Click" ToolTip="{local:Tr NewGroup}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8F4;" FontSize="16"/>
                                <TextBlock Text="{local:Tr Group}" Margin="7,0,0,0" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AddStepButton" Style="{StaticResource FlatIconButton}" Click="AddStepMenu_Click" ToolTip="{local:Tr Tip_AddStep}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="15"/>
                                <TextBlock Text="{local:Tr Step}" Margin="7,0,5,0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="9"/>
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{local:Tr Menu_Click}" Click="AddClick_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE962;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Tr Menu_Text}" Click="AddText_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE8AC;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Tr Wait}" Click="AddWait_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE916;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Tr Menu_Key}" Click="AddKey_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE765;"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{local:Tr Menu_Drag}" Click="AddDrag_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE7C2;"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,6"/>
                        <Button Style="{StaticResource FlatIconButton}" Click="MoveUp_Click" ToolTip="{local:Tr Tip_MoveUp}" IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource FlatIconButton}" Click="MoveDown_Click" ToolTip="{local:Tr Tip_MoveDown}" IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource FlatIconButton}" Click="ToggleEnabled_Click" ToolTip="{local:Tr Tip_Toggle}"
                                IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xED1A;" FontSize="16"/>
                        </Button>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,6"/>
                        <Button Style="{StaticResource FlatIconButton}" Click="ExpandAll_Click" ToolTip="{local:Tr Tip_ExpandAll}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE740;" FontSize="15"/>
                        </Button>
                        <Button Style="{StaticResource FlatIconButton}" Click="CollapseAll_Click" ToolTip="{local:Tr Tip_CollapseAll}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE73F;" FontSize="15"/>
                        </Button>
                        <Border Width="1" Background="{StaticResource BorderBrush}" Margin="10,6"/>
                        <Button Style="{StaticResource FlatIconButton}" Click="Delete_Click" ToolTip="{local:Tr Tip_Delete}" IsEnabled="{Binding HasSelection}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="16"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Zaglavlje stupaca -->
                <Grid DockPanel.Dock="Top" Margin="9,12,9,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="104"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ColumnHeader}" Text="#" Margin="16,0,0,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="{local:Tr ColStep}" Margin="26,0,0,0"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="{local:Tr ColAction}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="{local:Tr ColDelay}"/>
                </Grid>

                <Grid>
                    <ListBox x:Name="StepList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemTemplate="{StaticResource StepRowTemplate}" ItemContainerStyle="{StaticResource StepRow}"
                             Background="Transparent" BorderThickness="0" SelectionMode="Single" Padding="0,0,0,12"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             PreviewKeyDown="StepList_PreviewKeyDown"
                             MouseDoubleClick="StepList_MouseDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{local:Tr RunOnlyThis}" Click="RunSelected_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;"/></MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{local:Tr Cut}" Click="Cut_Click" InputGestureText="Ctrl+X"/>
                                <MenuItem Header="{local:Tr Copy}" Click="Copy_Click" InputGestureText="Ctrl+C"/>
                                <MenuItem Header="{local:Tr Paste}" Click="Paste_Click" InputGestureText="Ctrl+V"/>
                                <MenuItem Header="{local:Tr Duplicate}" Click="Duplicate_Click" InputGestureText="Ctrl+D"/>
                                <Separator/>
                                <MenuItem Header="{local:Tr NewGroup}" Click="AddGroup_Click"/>
                                <MenuItem Header="{local:Tr AddStep}">
                                    <MenuItem Header="{local:Tr Menu_Click}" Click="AddClick_Click"/>
                                    <MenuItem Header="{local:Tr Menu_Text}" Click="AddText_Click"/>
                                    <MenuItem Header="{local:Tr Wait}" Click="AddWait_Click"/>
                                    <MenuItem Header="{local:Tr Menu_Key}" Click="AddKey_Click"/>
                                    <MenuItem Header="{local:Tr Menu_Drag}" Click="AddDrag_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="{local:Tr MoveUp}" Click="MoveUp_Click" InputGestureText="Alt+↑"/>
                                <MenuItem Header="{local:Tr MoveDown}" Click="MoveDown_Click" InputGestureText="Alt+↓"/>
                                <MenuItem Header="{local:Tr ToggleEnabled}" Click="ToggleEnabled_Click" InputGestureText="Space"/>
                                <MenuItem Header="{local:Tr Delete}" Click="Delete_Click" InputGestureText="Del">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;"/></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,60">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Rows.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE962;" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{StaticResource FaintTextBrush}"/>
                        <TextBlock Text="{local:Tr EmptyTitle}" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,6,0,0" FontSize="13"
                                   Text="{local:Tr EmptyHint}"/>
                    </StackPanel>
                </Grid>
            </DockPanel>

            <Border Grid.Column="3" Background="{StaticResource BorderBrush}"/>

            <!-- ===== Desno: svojstva ===== -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="{StaticResource PanelBgBrush}">
                <StackPanel Margin="20,18,20,24" IsEnabled="{Binding IsIdle}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr StepProperties}"/>

                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource InvNullToVis}}" Margin="0,40,0,0">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;" FontSize="30" HorizontalAlignment="Center"
                                   Foreground="{StaticResource FaintTextBrush}"/>
                        <TextBlock Text="{local:Tr SelectStepOrGroup}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Foreground="{StaticResource DimTextBrush}"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                        <DockPanel Margin="0,18,0,20">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Selected.Glyph}" FontSize="30"
                                       Margin="4,0,16,0" Foreground="{Binding Selected.IconColor, Converter={StaticResource HexToBrush}}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.KindLabel}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Selected.Description}" Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Name}"/>
                            <TextBox x:Name="NameBox" Text="{Binding Selected.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <DockPanel Style="{StaticResource FormRow}">
                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Enabled}"/>
                            <CheckBox IsChecked="{Binding Selected.Enabled}" Content="{local:Tr EnabledRuns}"/>
                        </DockPanel>

                        <ContentControl Content="{Binding Selected}" Focusable="False" IsTabStop="False">
                            <ContentControl.Resources>

                                <!-- Grupa -->
                                <DataTemplate DataType="{x:Type local:GroupNode}">
                                    <TextBlock Style="{StaticResource Hint}" Text="{local:Tr GroupColorHint}"/>
                                </DataTemplate>

                                <!-- Klik -->
                                <DataTemplate DataType="{x:Type local:ClickStep}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr MouseButton}"/>
                                            <ComboBox ItemsSource="{x:Static local:Choices.MouseButtons}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Button}" HorizontalAlignment="Stretch"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr DoubleClick}"/>
                                            <CheckBox IsChecked="{Binding Clicks, Converter={StaticResource DoubleClick}}" Content="{local:Tr ClickTwice}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr PositionPx}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding X}" ToolTip="X"/>
                                                <TextBox Grid.Column="2" Text="{Binding Y}" ToolTip="Y"/>
                                                <Button Grid.Column="4" Click="PickPoint_Click" Tag="start" ToolTip="{local:Tr Tip_PickPoint}">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;"/>
                                                </Button>
                                            </Grid>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Povlacenje -->
                                <DataTemplate DataType="{x:Type local:DragStep}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr FromPx}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding X}" ToolTip="X"/>
                                                <TextBox Grid.Column="2" Text="{Binding Y}" ToolTip="Y"/>
                                                <Button Grid.Column="4" Click="PickPoint_Click" Tag="start" ToolTip="{local:Tr Tip_PickStart}">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;"/>
                                                </Button>
                                            </Grid>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr ToPx}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding X2}" ToolTip="X"/>
                                                <TextBox Grid.Column="2" Text="{Binding Y2}" ToolTip="Y"/>
                                                <Button Grid.Column="4" Click="PickPoint_Click" Tag="end" ToolTip="{local:Tr Tip_PickEnd}">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;"/>
                                                </Button>
                                            </Grid>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr MouseButton}"/>
                                            <ComboBox ItemsSource="{x:Static local:Choices.MouseButtons}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Button}" HorizontalAlignment="Stretch"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Duration}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                                            <TextBox Text="{Binding DurationMs}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Unos teksta -->
                                <DataTemplate DataType="{x:Type local:TextStep}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr InputMode}"/>
                                            <ComboBox ItemsSource="{x:Static local:Choices.TextModes}" DisplayMemberPath="Label"
                                                      SelectedValuePath="Value" SelectedValue="{Binding Mode}" HorizontalAlignment="Stretch"/>
                                        </DockPanel>

                                        <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVis}, ConverterParameter=Fixed}">
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Text}" VerticalAlignment="Top" Margin="0,7,10,0"/>
                                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                         TextWrapping="Wrap" MinHeight="36" MaxHeight="150" VerticalScrollBarVisibility="Auto"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr HideInView}"/>
                                                <CheckBox IsChecked="{Binding Masked}" Content="{local:Tr ShowDots}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding Mode, Converter={StaticResource EnumToVis}, ConverterParameter=Random}">
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr LengthRange}"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding MinLength}" ToolTip="{local:Tr Tip_MinChars}"/>
                                                    <TextBlock Grid.Column="1" Text="{local:Tr To}" Margin="10,0" VerticalAlignment="Center"
                                                               Foreground="{StaticResource DimTextBrush}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding MaxLength}" ToolTip="{local:Tr Tip_MaxChars}"/>
                                                </Grid>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Characters}"/>
                                                <ComboBox ItemsSource="{x:Static local:Choices.Charsets}" DisplayMemberPath="Label"
                                                          SelectedValuePath="Value" SelectedValue="{Binding Charset}" HorizontalAlignment="Stretch"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Prefix}"/>
                                                <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Tr Tip_Prefix}"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Suffix}"/>
                                                <TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Tr Tip_Suffix}"/>
                                            </DockPanel>
                                            <DockPanel Style="{StaticResource FormRow}">
                                                <Button DockPanel.Dock="Left" Width="122" Margin="0,0,10,0" Click="GenerateExample_Click"
                                                        HorizontalContentAlignment="Center" ToolTip="{local:Tr Tip_Example}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"/>
                                                        <TextBlock Text="{local:Tr Example}" Margin="7,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBox IsReadOnly="True" FontFamily="Consolas" VerticalContentAlignment="Center"
                                                         Text="{Binding DataContext.ExampleText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr ClickField}"/>
                                            <CheckBox IsChecked="{Binding ClickFirst}" Content="{local:Tr ClickBeforeInput}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}" Visibility="{Binding ClickFirst, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr PositionPx}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding X}" ToolTip="X"/>
                                                <TextBox Grid.Column="2" Text="{Binding Y}" ToolTip="Y"/>
                                                <Button Grid.Column="4" Click="PickPoint_Click" Tag="start" ToolTip="{local:Tr Tip_PickField}">
                                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;"/>
                                                </Button>
                                            </Grid>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr BeforeInput}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding ClearFirst}" Content="{local:Tr ClearField}"/>
                                                <CheckBox IsChecked="{Binding PressEnter}" Content="{local:Tr EnterAfter}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr CharDelay}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                                            <TextBox Text="{Binding CharDelayMs}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Cekanje -->
                                <DataTemplate DataType="{x:Type local:WaitStep}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Duration}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                                            <TextBox Text="{Binding Ms}"/>
                                        </DockPanel>
                                        <WrapPanel Margin="132,-4,0,8">
                                            <Button Style="{StaticResource SmallButton}" Content="{local:Tr Preset05}" Tag="500" Click="WaitPreset_Click"/>
                                            <Button Style="{StaticResource SmallButton}" Content="1 s" Tag="1000" Click="WaitPreset_Click"/>
                                            <Button Style="{StaticResource SmallButton}" Content="2 s" Tag="2000" Click="WaitPreset_Click"/>
                                            <Button Style="{StaticResource SmallButton}" Content="5 s" Tag="5000" Click="WaitPreset_Click"/>
                                            <Button Style="{StaticResource SmallButton}" Content="10 s" Tag="10000" Click="WaitPreset_Click"/>
                                            <Button Style="{StaticResource SmallButton}" Content="1 min" Tag="60000" Click="WaitPreset_Click"/>
                                        </WrapPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Random}"/>
                                            <CheckBox IsChecked="{Binding UseRandom}" Content="{local:Tr WaitRandomUpTo}"/>
                                        </DockPanel>
                                        <DockPanel Style="{StaticResource FormRow}" Visibility="{Binding UseRandom, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Maximum}"/>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                                            <TextBox Text="{Binding MaxMs}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>

                                <!-- Tipka -->
                                <DataTemplate DataType="{x:Type local:KeyStep}">
                                    <StackPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Key}"/>
                                            <TextBox IsReadOnly="True" FontWeight="SemiBold" Cursor="Hand"
                                                     Text="{Binding Combo, Mode=OneWay}" PreviewKeyDown="KeyCapture_PreviewKeyDown"
                                                     ToolTip="{local:Tr Tip_KeyCapture}"/>
                                        </DockPanel>
                                        <WrapPanel Margin="132,-4,0,8">
                                            <ItemsControl ItemsSource="{x:Static local:Choices.Keys}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource SmallButton}" Content="{Binding Label}" Click="KeyPreset_Click"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                        <DockPanel Style="{StaticResource FormRow}">
                                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Repeats}"/>
                                            <TextBox Text="{Binding Repeat}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>

                        <DockPanel Style="{StaticResource FormRow}"
                                   Visibility="{Binding Selected.HasDelayAfter, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr DelayAfterStep}"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                            <TextBox Text="{Binding Selected.DelayAfterMs}"/>
                        </DockPanel>

                        <Button Click="RunSelected_Click" HorizontalAlignment="Left" Margin="132,4,0,0"
                                ToolTip="{local:Tr Tip_RunOnlyThis}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Text="{local:Tr RunOnlyThis}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Izgled grupe -->
                        <StackPanel Visibility="{Binding Selected.IsGroup, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <Border Style="{StaticResource Divider}"/>
                            <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr GroupAppearance}"/>
                            <DockPanel Style="{StaticResource FormRow}" Margin="0,16,0,0">
                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Color}"/>
                                <Grid HorizontalAlignment="Left">
                                    <ToggleButton x:Name="ColorToggle" Padding="8,6" MinWidth="0">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="56" Height="22" CornerRadius="4"
                                                    Background="{Binding Selected.Color, Converter={StaticResource HexToBrush}}"/>
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="12,0,2,0"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsChecked, ElementName=ColorToggle}" PlacementTarget="{Binding ElementName=ColorToggle}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6"
                                           Closed="ColorPopup_Closed">
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="14,14,8,10">
                                            <StackPanel Width="140">
                                                <ItemsControl ItemsSource="{x:Static local:Palette.Colors}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource SwatchButton}" ToolTip="{Binding}" Click="Swatch_Click"
                                                                    Background="{Binding Converter={StaticResource HexToBrush}}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </DockPanel>
                            <DockPanel Style="{StaticResource FormRow}">
                                <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr CustomHex}"/>
                                <TextBox Text="{Binding Selected.Color}" FontFamily="Consolas" VerticalContentAlignment="Center"/>
                            </DockPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr AboutStep}"/>
                        <TextBlock Text="{Binding Selected.About}" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="21"
                                   Foreground="{StaticResource DimTextBrush}"/>

                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr Tips}" Margin="0,22,0,0"/>
                        <ItemsControl ItemsSource="{Binding Selected.Tips}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock DockPanel.Dock="Left" Text="•" Margin="2,0,10,0" Foreground="{StaticResource DimTextBrush}"/>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource DimTextBrush}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Donji panel ================= -->
        <Border Grid.Row="2" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Postavke petlje -->
                <StackPanel Grid.Column="0" Margin="20,16,20,12" IsEnabled="{Binding IsIdle}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr LoopSettings}"/>
                    <DockPanel Style="{StaticResource FormRow}" Margin="0,14,0,8">
                        <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr Loop}"/>
                        <CheckBox IsChecked="{Binding Settings.Loop}" Content="{local:Tr RepeatProcedure}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}" Margin="0,0,0,8" IsEnabled="{Binding Settings.Loop}">
                        <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr LoopCount}"/>
                        <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" Text="{Binding Settings.LoopCount}"
                                 Visibility="{Binding Settings.Infinite, Converter={StaticResource InvBoolToVis}}"/>
                        <ComboBox ItemsSource="{x:Static local:Choices.LoopModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                  SelectedValue="{Binding Settings.Infinite}" HorizontalAlignment="Stretch"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr CycleDelay}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                        <TextBox Text="{Binding Settings.CycleDelayMs}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr StartDelay}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="s"/>
                        <TextBox Text="{Binding Settings.StartDelaySec}"/>
                    </DockPanel>
                    <DockPanel Style="{StaticResource FormRow}" Margin="0" ToolTip="{local:Tr Tip_GameClicks}">
                        <TextBlock Style="{StaticResource FormLabelW}" Text="{local:Tr GameClicks}"/>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Unit}" Text="ms"/>
                        <TextBox DockPanel.Dock="Right" Width="64" Margin="8,0,0,0" Text="{Binding Settings.GameClickMs}"
                                 IsEnabled="{Binding Settings.GameClicks}"/>
                        <CheckBox IsChecked="{Binding Settings.GameClicks}" Content="{local:Tr GameClicksOn}"/>
                    </DockPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

                <!-- Zapisnik -->
                <DockPanel Grid.Column="2" Margin="20,16,14,12">
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButton}" Click="ClearLog_Click" Padding="10,3"
                                Content="{local:Tr Clear}" FontSize="13"/>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr ExecutionLog}"/>
                    </DockPanel>
                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Log}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource SuccessBrush}" FontSize="13"
                                                   Text="{Binding Time, StringFormat='[{0}]'}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ScrollViewer.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{local:Tr CopyLog}" Click="CopyLog_Click"/>
                                <MenuItem Header="{local:Tr Clear}" Click="ClearLog_Click"/>
                            </ContextMenu>
                        </ScrollViewer.ContextMenu>
                    </ScrollViewer>
                </DockPanel>

                <Border Grid.Column="3" Background="{StaticResource BorderBrush}" Margin="0,16"/>

                <!-- Statistika -->
                <StackPanel Grid.Column="4" Margin="20,16,20,12">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="{local:Tr Statistics}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/><RowDefinition Height="30"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{local:Tr TotalSteps}" Foreground="{StaticResource DimTextBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalSteps}" Margin="10,0,0,0"/>
                        <TextBlock Grid.Row="1" Text="{local:Tr TotalGroups}" Foreground="{StaticResource DimTextBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TotalGroups}" Margin="10,0,0,0"/>
                        <TextBlock Grid.Row="2" Text="{local:Tr CycleDuration}" Foreground="{StaticResource DimTextBrush}"
                                   ToolTip="{local:Tr Tip_CycleDuration}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EstimatedTime}" Margin="10,0,0,0"/>
                        <TextBlock Grid.Row="3" Text="{local:Tr ExecutedCycles}" Foreground="{StaticResource DimTextBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExecutedLoops}" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Column="5" Background="{StaticResource BorderBrush}" Margin="0,16"/>

                <!-- Pregled -->
                <DockPanel Grid.Column="6" Margin="20,16,20,16">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Text="{local:Tr Preview}"/>
                    <Border Margin="0,12,0,0" Background="#141419" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="8">
                        <local:ScreenPreview Node="{Binding Selected}" ToolTip="{local:Tr Tip_Preview}"/>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ================= Statusna traka ================= -->
        <Border Grid.Row="3" Background="{StaticResource WindowBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{local:Tr StatusLabel}" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}"/>
                    <Border CornerRadius="4" BorderThickness="1" Padding="8,2" Margin="8,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1A3DD68C"/>
                                <Setter Property="BorderBrush" Value="#553DD68C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="Running">
                                        <Setter Property="Background" Value="#267C5CFF"/>
                                        <Setter Property="BorderBrush" Value="#887C5CFF"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Recording">
                                        <Setter Property="Background" Value="#26E5484D"/>
                                        <Setter Property="BorderBrush" Value="#88E5484D"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="Picking">
                                        <Setter Property="Background" Value="#26F5A524"/>
                                        <Setter Property="BorderBrush" Value="#88F5A524"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ModeLabel}" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mode}" Value="Running">
                                            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="Recording">
                                            <Setter Property="Foreground" Value="#FF8A8D"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mode}" Value="Picking">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding RunInfo}" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}">
                    <Run Text="{local:Tr LoadedLabel}"/>
                    <Run Text="{Binding DocumentName, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                </TextBlock>
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource DimTextBrush}">
                    <Run Text="{local:Tr VersionLabel}"/>
                    <Run Text="{Binding Version, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
