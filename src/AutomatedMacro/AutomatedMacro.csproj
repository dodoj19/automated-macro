<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutomatedMacro</RootNamespace>
    <AssemblyName>AutomatedMacro</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Automated Macro</Product>
    <Version>1.1.0</Version>
    <Authors>Dorijan J.</Authors>
    <Company>Dorijan J.</Company>
    <Copyright>© 2026 Dorijan J.</Copyright>
    <!-- Fluent tema (ThemeMode) je u .NET-u jos oznacena kao eksperimentalna. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
  </ItemGroup>

</Project>
